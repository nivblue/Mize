<Project Sdk="Microsoft.NET.Sdk">

  <!-- Single test project holding Unit/, Api/ and Integration/ tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mize.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Test dependencies pinned to exact versions. -->
  <ItemGroup>
    <!-- Test host and runner integration. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- xUnit: test framework (plain Assert is used, no assertion library). -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Moq: mocks for isolating classes in unit tests. -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- WebApplicationFactory: boots the real API in memory for API and integration tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Mize.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
