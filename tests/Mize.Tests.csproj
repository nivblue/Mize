<Project Sdk="Microsoft.NET.Sdk">

  <!-- Single test project holding Unit/, Api/ and Integration/ tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mize.Tests</RootNamespace>
    <!-- Makes every dotnet test of this project collect code coverage (the settings file enables the Coverlet collector),
         with no extra command-line flag. To run once without coverage, pass an empty value: -p:RunSettingsFilePath= -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverage.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- Test dependencies pinned to exact versions. -->
  <ItemGroup>
    <!-- Test host and runner integration. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- xUnit: test framework (plain Assert is used, no assertion library). -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Moq: mocks for isolating classes in unit tests. -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Coverlet: code-coverage collector (the .NET counterpart of JaCoCo); only active when the collect option "XPlat Code Coverage" is passed to dotnet test. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- WebApplicationFactory: boots the real API in memory for API and integration tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Mize.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
