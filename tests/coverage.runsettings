<?xml version="1.0" encoding="utf-8" ?>
<!-- Coverlet settings, applied to every test run through RunSettingsFilePath in Mize.Tests.csproj. Measures only the API assembly (Mize.Api);
     the test projects and third-party packages are not part of the report. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Mize.Api]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
