{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Reservations": "Data Source=data/mize.db"
  },
  "Stats": {
    "FlushIntervalSeconds": 5
  },
  "RateLimit": {
    "MaxRequests": 100,
    "WindowSeconds": 60
  }
}
